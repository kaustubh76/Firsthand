# Shared variables for `test:testnet` and scripts. Copy to .env (git-ignored).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# DEPLOYER_PRIVATE_KEY=0x…        # only for forge script / relayer; never a user key
# USDC_ADDRESS=0x…                # testnet USDC (EIP-3009)

# Live-chain test tier and experiment arms (docs/DEVELOPMENT.md):
# ANVIL_RPC_URL=http://127.0.0.1:8545   # or $MONAD_RPC_URL for testnet runs
# DEPLOYMENTS_FILE=./deployments/31337.json
# RELAYER_PRIVATE_KEY=0x…               # pays gas for relayable verbs; never a user key
# BTX_RPC_URL=                          # encrypted-mempool endpoint for the `btx` arm — not deployed on Monad testnet as of 2026-09
# BTX_METHOD=eth_sendEncryptedRawTransaction
