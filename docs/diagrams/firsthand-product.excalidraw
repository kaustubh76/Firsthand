  {
   "id": "txt-impls",
   "type": "text",
   "x": 1816,
   "y": 1476.0,
   "width": 1088,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
