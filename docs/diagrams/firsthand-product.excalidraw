   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 settle(grantId, TermsInput, TransferAuthorization): status ACTIVE \u2227 hashTerms \u2227 value == price\n\u2022 EIP-3009 transferWithAuthorization pull \u2192 SplitMath (floor) \u2192 payees \u2192 residual to dust\n\u2022 Invariant (fuzz + invariant suites): router USDC balance == dustBalance; measured 241,741 gas/settle",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-router",
   "originalText": "\u2022 settle(grantId, TermsInput, TransferAuthorization): status ACTIVE \u2227 hashTerms \u2227 value == price\n\u2022 EIP-3009 transferWithAuthorization pull \u2192 SplitMath (floor) \u2192 payees \u2192 residual to dust\n\u2022 Invariant (fuzz + invariant suites): router USDC balance == dustBalance; measured 241,741 gas/settle",
   "autoResize": false,
   "lineHeight": 1.25
  },
