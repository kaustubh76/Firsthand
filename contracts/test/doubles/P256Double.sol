pragma solidity 0.8.30;

import {Vm} from "forge-std/Vm.sol";

/// @title P256Double
/// @notice Test double for the RIP-7212 precompile: etches the daimo-eth/p256-verifier runtime at 0x100.
/// @dev    Bytecode is `P256Verifier.deployedBytecode` compiled with its pinned solc 0.8.21 from
///         https://github.com/daimo-eth/p256-verifier @ 607d3ec8377a3f59d65eca60d87dee8485d2ebcc
///         (the submodule under lib/ lets a reviewer rebuild and diff). The fallback takes the same 160-byte
///         input as the precompile and returns 32 bytes: 1 on success, 0 otherwise. Local anvil/forge have no
///         precompile at 0x100; Monad testnet does — `test/fork` exercises the real one.
library P256Double {
    address internal constant PRECOMPILE = address(0x100);

    bytes internal constant RUNTIME =
        hex"";

    function etch(
        Vm vm
    ) internal {
        vm.etch(PRECOMPILE, RUNTIME);
        vm.label(PRECOMPILE, "P256Precompile(double)");
    }
}
