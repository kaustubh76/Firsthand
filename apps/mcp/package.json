{
  "name": "firsthand-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing FIRSTHAND's three verbs (deposit / query / rescind) to agent clients. Runs on the user's machine and may hold keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "firsthand-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:testnet": "echo 'no testnet tests yet'",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@firsthand/core": "workspace:*",
    "@firsthand/crypto": "workspace:*",
    "@firsthand/importers": "workspace:*",
    "@firsthand/runtime": "workspace:*",
    "@firsthand/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@firsthand/adapters": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
