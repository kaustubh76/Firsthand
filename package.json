{
  "name": "firsthand",
  "version": "0.1.0",
  "private": true,
  "description": "FIRSTHAND \u2014 a passkey-rooted data-provenance and consent-settlement protocol on Monad",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:testnet": "turbo run test:testnet",
    "coverage": "turbo run coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "vectors:gen": "turbo run gen",
    "vectors:check": "turbo run gen:check",
    "check:deps": "node scripts/check-deps.mjs",
    "check:env": "node scripts/check-env-example.mjs",
    "forge:test": "cd contracts && forge test",
    "forge:build": "cd contracts && forge build",
    "abi:export": "node scripts/export-abi.mjs",
    "forge:gate": "node scripts/forge-gate.mjs",
    "check:all": "pnpm lint && pnpm check:deps && pnpm check:env && pnpm build && pnpm typecheck && pnpm coverage && pnpm vectors:check && pnpm forge:gate",
    "test:anvil": "node scripts/anvil-gate.mjs",
    "demo": "pnpm --filter firsthand-demo dev",
    "deploy:hosted": "node scripts/deploy-hosted.mjs",
    "deploy:gateway": "node scripts/deploy-hosted.mjs gateway",
    "deploy:capture": "node scripts/deploy-hosted.mjs capture",
    "spike:android": "pnpm --filter @firsthand/core spike:android"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
