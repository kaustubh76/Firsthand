{
  "name": "firsthand-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "firsthand-demo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:testnet": "echo 'no testnet tests yet'",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@firsthand/adapters": "workspace:*",
    "@firsthand/contracts": "workspace:*",
    "@firsthand/core": "workspace:*",
    "@firsthand/crypto": "workspace:*",
    "@firsthand/runtime": "workspace:*",
    "@firsthand/sdk": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
