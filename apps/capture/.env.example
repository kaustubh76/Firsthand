# Vite exposes only VITE_* variables to the browser. No secrets belong here.

# Point the app at a gateway and it discovers every contract address, the epoch parameters and
# whether it may relay transactions from /.well-known/firsthand.json. This is the browser's
# substitute for deployments/<chainId>.json, which it cannot read.
VITE_GATEWAY_URL=http://localhost:8402

# Needed for reads (receipts, anchor lookups). Published by the gateway too; set it to override.
VITE_RPC_URL=https://testnet-rpc.monad.xyz

# Offline fallback only — ignored when the gateway answers. Anchoring additionally requires the
# gateway to run with RELAY_ENABLED=true, since the browser holds no key and pays no gas.
VITE_CHAIN_ID=10143
VITE_PASSPORT_ANCHORS=0x0000000000000000000000000000000000000000
VITE_GRANT_MANAGER=0x0000000000000000000000000000000000000000
VITE_PRINCIPAL_REGISTRY=0x0000000000000000000000000000000000000000
VITE_RESCISSIONS=0x0000000000000000000000000000000000000000
VITE_EPOCH_GENESIS=0
VITE_EPOCH_LENGTH=604800
