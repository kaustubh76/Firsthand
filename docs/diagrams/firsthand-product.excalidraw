   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 PassportCatalog (memory | fs): public sidecars; BlobStore (memory | fs; IPFS shell): ciphertext only\n\u2022 Token-bucket pre-filter; the on-chain ReceiptLedger counter is the truth\n\u2022 RELAYER_PRIVATE_KEY pays gas for RoyaltyRouter.settle and nothing else \u2014 never a user key",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-storage",
   "originalText": "\u2022 PassportCatalog (memory | fs): public sidecars; BlobStore (memory | fs; IPFS shell): ciphertext only\n\u2022 Token-bucket pre-filter; the on-chain ReceiptLedger counter is the truth\n\u2022 RELAYER_PRIVATE_KEY pays gas for RoyaltyRouter.settle and nothing else \u2014 never a user key",
   "autoResize": false,
   "lineHeight": 1.25
  },
