   "text": "\u2022 registerCard(owner, x25519Pub) \u00b7 acceptTerms(card, principal, TermsInput, nonce, cardSig) \u2014 terms by preimage\n\u2022 grant(\u2026, term \u2264 8, termsHash, wrapRef, authoritySig) \u2014 P-256; price \u2265 floor; wrapRef never re-released\n\u2022 rescind(grantId, epoch, nonce, sig) \u2014 effective at inclusion \u00b7 revealRescind(grantId, salt, \u2026) within revealWindowBlocks\n\u2022 effectiveStatus (lazy): RESCINDED > EXPIRED > FROZEN (registry.isLive) > ACTIVE",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-grants",
   "originalText": "\u2022 registerCard(owner, x25519Pub) \u00b7 acceptTerms(card, principal, TermsInput, nonce, cardSig) \u2014 terms by preimage\n\u2022 grant(\u2026, term \u2264 8, termsHash, wrapRef, authoritySig) \u2014 P-256; price \u2265 floor; wrapRef never re-released\n\u2022 rescind(grantId, epoch, nonce, sig) \u2014 effective at inclusion \u00b7 revealRescind(grantId, salt, \u2026) within revealWindowBlocks\n\u2022 effectiveStatus (lazy): RESCINDED > EXPIRED > FROZEN (registry.isLive) > ACTIVE",
   "autoResize": false,
   "lineHeight": 1.25
  },
