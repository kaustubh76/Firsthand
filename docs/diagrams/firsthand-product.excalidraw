   "link": null,
   "locked": false,
   "text": "\u2022 record(grantId, queryNonce, payer, ns, termsHash, rateLimit, epoch) \u2014 router-only\n\u2022 receiptId = keccak(grantId, authNonce): payment and receipt dedup coincide\n\u2022 queriesThisEpoch < rateLimit (0 = unlimited); every read is an on-chain receipt (\u00a71)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-ledger",
   "originalText": "\u2022 record(grantId, queryNonce, payer, ns, termsHash, rateLimit, epoch) \u2014 router-only\n\u2022 receiptId = keccak(grantId, authNonce): payment and receipt dedup coincide\n\u2022 queriesThisEpoch < rateLimit (0 = unlimited); every read is an on-chain receipt (\u00a71)",
   "autoResize": false,
   "lineHeight": 1.25
  },
