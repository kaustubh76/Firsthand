# ─── firsthand-mcp ────────────────────────────────────────────────────────────────────────────
# Runs on the USER's machine. May derive keys. stdout is the MCP channel; logs go to stderr.
LOG_LEVEL=info

# ── Chain / contracts (from deployments/<chainId>.json) ──
CHAIN_ID=10143
PASSPORT_ANCHORS=0x0000000000000000000000000000000000000000
PRINCIPAL_REGISTRY=0x0000000000000000000000000000000000000000
GRANT_MANAGER=0x0000000000000000000000000000000000000000
RESCISSIONS=0x0000000000000000000000000000000000000000
EPOCH_GENESIS=0
EPOCH_LENGTH=604800

# ── Relaying (optional) ──
# With both set, enroll/attest broadcast through this wallet, which pays gas and is unlinkable to the
# principal. Without them the tools return signed calldata for out-of-band submission.
# DEPLOYMENTS_FILE=../../deployments/10143.json   # one source of truth for every address + epochs.
#                                                 # Without it, deposits are NEVER anchored and no
#                                                 # buyer can recall them (the tool warns you).
# GATEWAY_URL=http://localhost:8402               # where ciphertext + sidecars are published
# RPC_URL=http://127.0.0.1:8545
# RELAYER_PRIVATE_KEY=0x…   # never a user key
# BTX_RPC_URL=              # encrypted-mempool submission endpoint; rescissions travel BTX when set.
#                           # Not deployed on Monad testnet as of 2026-09 — leave unset and use
#                           # path "commit-reveal" (works everywhere) or "public" (measurable baseline).
# BTX_METHOD=eth_sendEncryptedRawTransaction   # JSON-RPC method name once Monad confirms it

# ── Buyer side (optional) — the AGENT's keys, never a principal's ──
# BUYER_PRIVATE_KEY=0x…     # EVM key that signs terms acceptance and pays x402 queries
# GRANTEE_SEED_HEX=0x…      # 32-byte seed for the X25519 key vault keys are wrapped to

# ── PRF (demo/dev only) ──
PRF_SOURCE=static
# FIRSTHAND_STATIC_PRF_HEX=0x<64 hex>   # NOT rooted in a passkey; use only for demos and tests
BLOB_DIR=./data/blobs
