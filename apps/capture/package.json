  "private": true,
  "description": "Minimal capture PWA: passkey enrolment (WebAuthn PRF), phone capture → passport, locker view, rescind",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
