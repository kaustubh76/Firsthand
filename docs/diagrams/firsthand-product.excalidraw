   "seed": 257141749,
   "version": 1,
   "versionNonce": 2018810723,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 S1 deposit-scale (H3/H1): 10 k passports \u2192 Merkle-only verify 1.93 s; full ECDSA re-proof 31.4 s; 657 gas/passport baseline\n\u2022 S2 buyer loop (H1): 100 paid queries, 241,741 gas/settle, manifest with receipts verifies, rescinded \u2192 GrantNotLive\n\u2022 S3 rescission race (H2, 50 trials/arm, 400 ms fee-ordered blocks): B2 0.98 \u00b7 commit-reveal 1.00 \u00b7 btx-blind 0.98 \u00b7 btx skipped\n\u2022 S4 refusal: precision 1.0 / recall 1.0; 20/20 forged anchors refused on chain\n\u2022 Harness: arms, AnvilMiner, TxpoolPollingFeed, ObserverBot, Extractor; results/*.json + report",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-experiments",
   "originalText": "\u2022 S1 deposit-scale (H3/H1): 10 k passports \u2192 Merkle-only verify 1.93 s; full ECDSA re-proof 31.4 s; 657 gas/passport baseline\n\u2022 S2 buyer loop (H1): 100 paid queries, 241,741 gas/settle, manifest with receipts verifies, rescinded \u2192 GrantNotLive\n\u2022 S3 rescission race (H2, 50 trials/arm, 400 ms fee-ordered blocks): B2 0.98 \u00b7 commit-reveal 1.00 \u00b7 btx-blind 0.98 \u00b7 btx skipped\n\u2022 S4 refusal: precision 1.0 / recall 1.0; 20/20 forged anchors refused on chain\n\u2022 Harness: arms, AnvilMiner, TxpoolPollingFeed, ObserverBot, Extractor; results/*.json + report",
   "autoResize": false,
   "lineHeight": 1.25
  },
