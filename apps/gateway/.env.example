# ─── firsthand-gateway ────────────────────────────────────────────────────────────────────────
# The serving path. Holds NO key material: no PRF, no vault keys, no plaintext. Everything it
# serves is ciphertext plus public proofs; settlement runs through the x402 facilitator.

# ── Server ──
PORT=8402
HOST=0.0.0.0
LOG_LEVEL=info            # debug | info | warn | error | silent
LOG_JSON=false            # true for one-JSON-object-per-line logs

# ── Chain ──
CHAIN_ID=10143            # Monad testnet — verify before deployment
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# DEPLOYMENTS_FILE=../../deployments/10143.json   # written by contracts/script/Deploy.s.sol; binds anchors,
#                                                   grants, USDC and payTo (RoyaltyRouter) from chain
# DEPLOYMENT_JSON={"chainId":10143,...}            # the same document inline, for hosts with no disk
PASSPORT_ANCHORS=0x0000000000000000000000000000000000000000   # passport EIP-712 domain in memory mode only

# ── Settlement ──
SETTLEMENT_MODE=memory    # memory (accounting double) | onchain (relayer calls RoyaltyRouter.settle)
# RELAYER_PRIVATE_KEY=0x…  # pays gas for settlements; NEVER a user key
# RELAY_ENABLED=false      # POST /v1/relay submits signature-authorised calls for keyless clients
#                          # (the capture PWA). Allow-listed to this deployment's authority
#                          # contracts, value must be 0, simulated first. It spends relayer gas.
# RELAY_FAUCET_MINT=false  # also relay MockUSDC.mint (testnet faucet double only) so a keyless demo
#                          # buyer can fund itself. Never against a real stablecoin.
# LEDGER_MAX_SCAN_BLOCKS=5000   # furthest back ?fromBlock= may reach on the audit routes
# LEDGER_FROM_BLOCK=            # deployment block; without it the ledger looks back LOOKBACK only
# LEDGER_LOOKBACK_BLOCKS=500    # how far back to scan when LEDGER_FROM_BLOCK is unset
# LEDGER_MAX_RANGE=100          # blocks per eth_getLogs — Monad's public RPC caps this at 100
# LEDGER_MIN_REQUEST_INTERVAL_MS=50   # that RPC also caps throughput; hosted uses 80
# LEDGER_MAX_IN_FLIGHT=4        # concurrent getLogs; hosted uses 3
# LEDGER_SCAN_BUDGET_MS=40000   # wall-clock budget per audit request; a spent budget answers
#                               # `scan.partial` rather than timing out
# RELAYER_LOW_WATERMARK_MON=0.5 # /healthz reports relayer.low below this — the refill signal
# RELAY_FAUCET_MAX_UNITS=1000000  # largest MockUSDC amount one relayed mint may carry (1 USDC)
# ERC8004_FEEDBACK=false        # credit each paid query to the buyer's ERC-8004 agent. Costs
#                               # relayer gas per query; the hosted gateway sets it true.
# HARDWARE_REQUIRE_VERIFIED_BOOT=false  # refuse class 3 unless the device's verified-boot
#                               # state is Verified (ADR-0015). The chain records that
#                               # state and does not enforce it; this is where policy lives.
FRESHNESS_HALF_LIFE_S=        # staleness half-life per namespace (README §7.3); default 1 epoch
# CAPTURE_URL=                  # the capture app this gateway points at, published in discovery

# ── x402 settlement ──
# memory: the double — matches scheme/amount/nonce but NEVER checks the signature, so it must not
#         face the public. local: this gateway verifies EIP-3009 itself, no third party.
# monad:  Monad's native facilitator verifies, falling back to `local` (ADR-0014).
X402_MODE=memory
# X402_FACILITATOR_URL=     # defaults to https://x402-facilitator.molandak.org in monad mode
# X402_FACILITATOR_API_KEY= # the public facilitator needs none
# X402_VERIFY_FALLBACK=true # may a facilitator that cannot answer hand over to the local verifier
# X402_FALLBACK_REASONS=    # extra refusal reasons that mean "not my kind of payment", comma-separated
X402_NETWORK=monad-testnet  # either spelling: monad-testnet (v1) or eip155:10143 (v2)
USDC_ADDRESS=0x0000000000000000000000000000000000000dc0
PAY_TO=0x0000000000000000000000000000000000000000   # RoyaltyRouter address (decision #9)
PUBLIC_URL=http://localhost:8402
CORS_ORIGINS=*            # browser origins allowed in (the PWA is on another host); comma-separated

# ── Blob storage (ciphertext only) and passport catalog (public sidecars) ──
BLOB_STORE=memory         # memory | fs | vercel (Vercel Blob, durable on serverless hosts) | ipfs
BLOB_DIR=./data/blobs
# IPFS_API_URL=http://127.0.0.1:5001   # required for BLOB_STORE=ipfs — a Kubo RPC API. Blobs keep
#                                      # their keccak id; the CID is derived from it (keccak-256
#                                      # multihash), so nothing is indexed. The node must offer
#                                      # keccak-256, which Kubo does: docker run -p 5001:5001 ipfs/kubo
CATALOG=memory            # memory | fs | vercel
CATALOG_DIR=./data/passports
# BLOB_READ_WRITE_TOKEN=   # for the vercel stores; Vercel injects it when a Blob store is connected
BLOB_PREFIX=firsthand     # key prefix inside the store
MAX_UPLOAD_BYTES=8388608
USDC_NAME=USD Coin        # EIP-712 domain of the asset buyers sign for
USDC_VERSION=2

# ── Rate-limit pre-filter (chain-side counters in ReceiptLedger are the source of truth) ──
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SECOND=1
