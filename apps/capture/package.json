    "test:testnet": "echo 'no testnet tests'",
    "coverage": "vitest run --coverage",
    "bundle:vercel": "node scripts/vercel-bundle.mjs"
  },
  "dependencies": {
    "@firsthand/adapters": "workspace:*",
    "@firsthand/core": "workspace:*",
    "@firsthand/crypto": "workspace:*",
    "@firsthand/sdk": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:"
  }
}
