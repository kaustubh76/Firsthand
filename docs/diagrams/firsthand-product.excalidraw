   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 GET /v1/query/:grantId/:passportId \u2014 402 priced from the sidecar \u2192 X-PAYMENT \u2192 verify \u2192 settle \u2192 serve\n\u2022 GET /v1/passports/:id \u00b7 /v1/blobs/:id \u00b7 /v1/grants/:id/wrap \u00b7 /v1/anchors/:root\n\u2022 POST /v1/passports \u00b7 /v1/blobs \u00b7 /v1/grants/:id/wrap \u2014 verified ingest\n\u2022 /.well-known/firsthand.json \u00b7 /healthz; RFC 9457 problem+json with FH_* codes",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-routes",
   "originalText": "\u2022 GET /v1/query/:grantId/:passportId \u2014 402 priced from the sidecar \u2192 X-PAYMENT \u2192 verify \u2192 settle \u2192 serve\n\u2022 GET /v1/passports/:id \u00b7 /v1/blobs/:id \u00b7 /v1/grants/:id/wrap \u00b7 /v1/anchors/:root\n\u2022 POST /v1/passports \u00b7 /v1/blobs \u00b7 /v1/grants/:id/wrap \u2014 verified ingest\n\u2022 /.well-known/firsthand.json \u00b7 /healthz; RFC 9457 problem+json with FH_* codes",
   "autoResize": false,
   "lineHeight": 1.25
  },
