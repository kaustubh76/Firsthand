{
  "name": "@firsthand/experiments",
  "version": "0.1.0",
  "private": true,
  "description": "Research harness for README \u00a715: scenarios S1\u2013S4, arms B1/B2/BTX/commit-reveal, metrics for H1\u2013H3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:testnet": "echo 'On-chain arms take ANVIL_RPC_URL=$MONAD_RPC_URL + DEPLOYMENTS_FILE + RELAYER_PRIVATE_KEY (docs/DEVELOPMENT.md); S3 needs a pending-tx feed the node exposes'",
    "coverage": "vitest run --coverage",
    "run": "tsx src/cli.ts",
    "s1": "tsx src/cli.ts s1",
    "s2": "tsx src/cli.ts s2",
    "s3": "tsx src/cli.ts s3",
    "s4": "tsx src/cli.ts s4",
    "report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "@firsthand/adapters": "workspace:*",
    "@firsthand/contracts": "workspace:*",
    "@firsthand/core": "workspace:*",
    "@firsthand/crypto": "workspace:*",
    "@firsthand/runtime": "workspace:*",
    "@firsthand/sdk": "workspace:*",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
