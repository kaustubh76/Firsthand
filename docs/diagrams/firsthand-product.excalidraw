   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 commit(keccak(grantId \u2016 salt)) \u2014 anyone may post (relayable, sender unlinkable)\n\u2022 commitBlock(commitment) \u2014 the effective end of consent on the fallback path\n\u2022 BTX is a transport property, not a contract API: rescind is the same call on both arms",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-rescissions",
   "originalText": "\u2022 commit(keccak(grantId \u2016 salt)) \u2014 anyone may post (relayable, sender unlinkable)\n\u2022 commitBlock(commitment) \u2014 the effective end of consent on the fallback path\n\u2022 BTX is a transport property, not a contract API: rescind is the same call on both arms",
   "autoResize": false,
   "lineHeight": 1.25
  },
