   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 One passkey, no seed phrase; every key derives from its PRF output (\u00a77.3)\n\u2022 Enrolls once, re-attests weekly (liveness), deposits, grants, rescinds\n\u2022 All secrets stay on the principal's device \u2014 never on a gateway\n\u2022 Recovery: single passkey in the demo; guardian threshold is roadmap (\u00a713)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-principal",
   "originalText": "\u2022 One passkey, no seed phrase; every key derives from its PRF output (\u00a77.3)\n\u2022 Enrolls once, re-attests weekly (liveness), deposits, grants, rescinds\n\u2022 All secrets stay on the principal's device \u2014 never on a gateway\n\u2022 Recovery: single passkey in the demo; guardian threshold is roadmap (\u00a713)",
   "autoResize": false,
   "lineHeight": 1.25
  },
