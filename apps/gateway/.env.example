# ─── firsthand-gateway ────────────────────────────────────────────────────────────────────────
# The serving path. Holds NO key material: no PRF, no vault keys, no plaintext. Everything it
# serves is ciphertext plus public proofs; settlement runs through the x402 facilitator.

# ── Server ──
PORT=8402
HOST=0.0.0.0
LOG_LEVEL=info            # debug | info | warn | error | silent
LOG_JSON=false            # true for one-JSON-object-per-line logs

# ── Chain ──
CHAIN_ID=10143            # Monad testnet — verify before deployment
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# DEPLOYMENTS_FILE=../../deployments/10143.json   # written by contracts/script/Deploy.s.sol; binds anchors,
#                                                   grants, USDC and payTo (RoyaltyRouter) from chain
# DEPLOYMENT_JSON={"chainId":10143,...}            # the same document inline, for hosts with no disk
PASSPORT_ANCHORS=0x0000000000000000000000000000000000000000   # passport EIP-712 domain in memory mode only

# ── Settlement ──
SETTLEMENT_MODE=memory    # memory (accounting double) | onchain (relayer calls RoyaltyRouter.settle)
# RELAYER_PRIVATE_KEY=0x…  # pays gas for settlements; NEVER a user key
# RELAY_ENABLED=false      # POST /v1/relay submits signature-authorised calls for keyless clients
#                          # (the capture PWA). Allow-listed to this deployment's authority
#                          # contracts, value must be 0, simulated first. It spends relayer gas.

# ── x402 settlement ──
X402_MODE=memory          # memory (no network, tests/demo) | monad (native facilitator)
# X402_FACILITATOR_URL=https://x402.monad.xyz
# X402_FACILITATOR_API_KEY=
X402_NETWORK=monad-testnet
USDC_ADDRESS=0x0000000000000000000000000000000000000dc0
PAY_TO=0x0000000000000000000000000000000000000000   # RoyaltyRouter address (decision #9)
PUBLIC_URL=http://localhost:8402
CORS_ORIGINS=*            # browser origins allowed in (the PWA is on another host); comma-separated

# ── Blob storage (ciphertext only) and passport catalog (public sidecars) ──
BLOB_STORE=memory         # memory | fs | vercel (Vercel Blob — durable on serverless hosts)
BLOB_DIR=./data/blobs
CATALOG=memory            # memory | fs | vercel
CATALOG_DIR=./data/passports
# BLOB_READ_WRITE_TOKEN=   # for the vercel stores; Vercel injects it when a Blob store is connected
BLOB_PREFIX=firsthand     # key prefix inside the store
MAX_UPLOAD_BYTES=8388608
USDC_NAME=USD Coin        # EIP-712 domain of the asset buyers sign for
USDC_VERSION=2

# ── Rate-limit pre-filter (chain-side counters in ReceiptLedger are the source of truth) ──
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SECOND=1
