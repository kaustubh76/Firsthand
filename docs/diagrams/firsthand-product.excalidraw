   "updated": 1758000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 402 carries accepts[]: maxAmountRequired = price, payTo = RoyaltyRouter, extra.{chainId, name, version, chainTime}\n\u2022 Buyer signs EIP-3009 TransferWithAuthorization under the USDC domain; header X-PAYMENT\n\u2022 Facilitator: MemoryFacilitator (built) | MonadFacilitatorClient (built; live interop Phase 5)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-x402",
   "originalText": "\u2022 402 carries accepts[]: maxAmountRequired = price, payTo = RoyaltyRouter, extra.{chainId, name, version, chainTime}\n\u2022 Buyer signs EIP-3009 TransferWithAuthorization under the USDC domain; header X-PAYMENT\n\u2022 Facilitator: MemoryFacilitator (built) | MonadFacilitatorClient (built; live interop Phase 5)",
   "autoResize": false,
   "lineHeight": 1.25
  },
